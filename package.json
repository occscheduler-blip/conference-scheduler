{
  "name": "conference-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "desktop:frontend:dev": "BUILD_TARGET=desktop NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:17850 next dev",
    "desktop:frontend:build": "node scripts/build-desktop-frontend.mjs",
    "desktop:backend:build": "cd backend && .venv/bin/pyinstaller --noconfirm desktop.spec && node ../scripts/copy-sidecar.mjs",
    "desktop:dev": "npm run desktop:backend:build && tauri dev",
    "desktop:build": "npm run desktop:backend:build && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^26",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2"
  }
}
