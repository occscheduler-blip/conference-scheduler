{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conference Scheduler",
  "version": "0.1.0",
  "identifier": "edu.hamilton.conference-scheduler",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "beforeBuildCommand": "npm run desktop:frontend:build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Conference Scheduler",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "url": "loader.html",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/conference-backend/**/*"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {}
}
