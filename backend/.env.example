# FastAPI app configuration
APP_NAME=Conference Scheduler API
APP_ENV=development
APP_PORT=8000

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=https://conference-scheduler-lime.vercel.app,http://localhost:3000

# Supabase configuration
SUPABASE_URL=https://lcrargufjpgmnfrzbllx.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres.lcrargufjpgmnfrzbllx:[SUPABASE_PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# JWT Authentication Key
JWT_SECRET_KEY==<random-secret>

# SMTP (transactional email for OTP sign-in and notifications)
# Defaults to Gmail; override SMTP_HOST/SMTP_PORT for a different provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Full email address of the sending mailbox
SMTP_USERNAME=your.email@hamilton.edu
# 16-character Google App Password (requires 2-Step Verification on the account)
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional display-name format; defaults to SMTP_USERNAME if blank
SMTP_FROM=Conference Scheduler <your.email@hamilton.edu>
