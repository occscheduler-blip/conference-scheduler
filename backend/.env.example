# ─── Application ───────────────────────────────────────────────────────────
APP_NAME=Conference Scheduler API
# Set to "production" on your deployment host
APP_ENV=development
APP_PORT=8000

# ─── Security ──────────────────────────────────────────────────────────────
# Must match BACKEND_API_KEY in root .env
# Generate: openssl rand -hex 32
BACKEND_API_KEY=your-api-key-here

# ─── CORS ──────────────────────────────────────────────────────────────────
# Dev:        http://localhost:3000
# Production: https://your-app.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────────
# Found in: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Found in: Supabase dashboard > Project Settings > Database > Connection string
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[SUPABASE_PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ─── Table names ───────────────────────────────────────────────────────────
SUPABASE_EVENTS_TABLE=events
SUPABASE_SYMPOSIUMS_TABLE=symposiums
SUPABASE_DEPARTMENTS_TABLE=departments
SUPABASE_TIMEFRAMES_TABLE=timeframes
SUPABASE_STUDENTS_TABLE=students
