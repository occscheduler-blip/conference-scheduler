# ─── Next.js / Vercel ──────────────────────────────────────────────────────
# URL of your deployed FastAPI backend. Used server-side only by the proxy.
# Do NOT use NEXT_PUBLIC_ prefix — this variable must stay server-only.
# Dev:        http://localhost:8000
# Production: https://your-backend.railway.app (or equivalent)
BACKEND_URL=http://localhost:8000

# Shared secret between the Next.js proxy and the FastAPI backend.
# Must match BACKEND_API_KEY in backend/.env
# Generate: openssl rand -hex 32
BACKEND_API_KEY=your-api-key-here
